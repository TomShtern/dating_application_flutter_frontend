# API and Backend Configuration
# For local Android emulator development (10.0.2.2 maps to host machine 127.0.0.1)
DATING_APP_API_BASE_URL=http://10.0.2.2:7070

# For Windows desktop, macOS, or Chrome development:
# DATING_APP_API_BASE_URL=http://127.0.0.1:7070

# For physical device testing over local Wi-Fi:
# DATING_APP_API_BASE_URL=http://<YOUR_LAN_IP>:7070

# Shared secret key matching backend configuration for dev routes
DATING_APP_SHARED_SECRET=dev-shared-secret

# Clerk publishable key (dev instance). Public and safe to ship in the app.
# NEVER put a Clerk secret key (sk_...) here or anywhere in the app.
CLERK_PUBLISHABLE_KEY=pk_test_ZmlybS1hbmNob3Z5LTg0MTcuY2xlcmsuYWNjb3VudHMuZGV2JA

# Debug-only quick sign-in list on the sign-in screen (ignored in release).
# Format: label|email|password entries separated by ";" (no ";" or "|" inside).
# Use Clerk dev test addresses, e.g. alice+clerk_test@example.com.
# CLERK_TEST_ACCOUNTS=Alice|alice+clerk_test@example.com|Passw0rd!x;Bob|bob+clerk_test@example.com|Passw0rd!x
