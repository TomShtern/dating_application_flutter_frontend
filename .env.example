# API and Backend Configuration
# For local Android emulator development (10.0.2.2 maps to host machine 127.0.0.1)
DATING_APP_API_BASE_URL=http://10.0.2.2:7070

# For Windows desktop, macOS, or Chrome development:
# DATING_APP_API_BASE_URL=http://127.0.0.1:7070

# For physical device testing over local Wi-Fi:
# DATING_APP_API_BASE_URL=http://<YOUR_LAN_IP>:7070

# Shared secret key matching backend configuration for dev routes
DATING_APP_SHARED_SECRET=dev-shared-secret
